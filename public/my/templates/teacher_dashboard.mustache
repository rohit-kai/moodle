{{!
    Educator & Teacher Dashboard rendered for teachers and course creators on the my moodle page.

    @package my
    @copyright 2026
    @license http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
}}
<style>
    /* Aesthetic Professional Theme - Educator & Teacher Dashboard */
    body#page-my-index #page,
    body#page-my-index #page-content,
    body#page-my-index #region-main,
    body#page-my-index .main-inner {
        max-width: 100% !important;
        width: 100% !important;
        padding-left: 0.75rem !important;
        padding-right: 0.75rem !important;
        margin-left: 0 !important;
        margin-right: 0 !important;
    }

    .teacher-dashboard {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        color: #1e293b;
    }

    /* Executive Dark Navy / Slate Header Banner */
    .teacher-header-card {
        background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
        color: #ffffff;
        border-radius: 0.75rem;
        box-shadow: 0 4px 18px rgba(15, 23, 42, 0.1);
        border: 1px solid #334155;
    }
    .teacher-header-card h3 {
        color: #ffffff !important;
        font-weight: 700;
        letter-spacing: -0.01em;
    }
    .teacher-header-card p {
        color: #94a3b8 !important;
        font-size: 0.9rem;
    }

    /* Professional Educator Tabs */
    .teacher-nav-tabs .nav-link {
        color: #94a3b8;
        border: none;
        border-bottom: 2px solid transparent;
        font-weight: 600;
        font-size: 0.875rem;
        padding: 0.65rem 1.15rem;
        transition: all 0.2s ease;
    }
    .teacher-nav-tabs .nav-link:hover {
        color: #f8fafc;
        border-bottom-color: #475569;
    }
    .teacher-nav-tabs .nav-link.active {
        color: #ffffff !important;
        background: transparent !important;
        border-bottom-color: #6366f1 !important;
    }

    /* Cards & Widgets */
    .teacher-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 0.65rem;
        box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }
    .teacher-card:hover {
        border-color: #cbd5e1;
        box-shadow: 0 4px 12px rgba(15, 23, 42, 0.06);
    }
    .teacher-card-header {
        background-color: #f8fafc;
        border-bottom: 1px solid #e2e8f0;
        color: #0f172a;
        font-weight: 600;
        font-size: 0.9rem;
    }

    /* Stat Cards */
    .stat-card-teacher {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-top: 3px solid #6366f1;
        border-radius: 0.65rem;
        padding: 0.9rem 1rem;
        box-shadow: 0 1px 3px rgba(15, 23, 42, 0.03);
    }
    .stat-card-teacher .stat-value {
        font-size: 1.5rem;
        font-weight: 700;
        color: #0f172a;
        line-height: 1.2;
    }
    .stat-card-teacher .stat-label {
        font-size: 0.75rem;
        font-weight: 600;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        margin-top: 0.25rem;
    }

    /* Buttons */
    .btn-teacher-primary {
        background-color: #4f46e5;
        border-color: #4f46e5;
        color: #ffffff !important;
        font-weight: 600;
        font-size: 0.85rem;
        padding: 0.45rem 1rem;
        border-radius: 0.4rem;
        transition: all 0.15s ease;
    }
    .btn-teacher-primary:hover {
        background-color: #4338ca;
        border-color: #4338ca;
        color: #ffffff !important;
    }

    .btn-pro-outline {
        border: 1px solid #cbd5e1;
        color: #334155 !important;
        background-color: #ffffff;
        font-weight: 600;
        font-size: 0.85rem;
        padding: 0.45rem 1rem;
        border-radius: 0.4rem;
        transition: all 0.15s ease;
    }
    .btn-pro-outline:hover {
        background-color: #f8fafc;
        border-color: #94a3b8;
        color: #0f172a !important;
    }

    .btn-banner-outline {
        border: 1px solid #475569;
        color: #f8fafc !important;
        background-color: rgba(255, 255, 255, 0.05);
        font-weight: 600;
        font-size: 0.85rem;
        padding: 0.45rem 1rem;
        border-radius: 0.4rem;
        transition: all 0.15s ease;
    }
    .btn-banner-outline:hover {
        background-color: rgba(255, 255, 255, 0.15);
        color: #ffffff !important;
        border-color: #94a3b8;
    }

    /* Badges */
    .badge-pro-soft {
        background-color: #f1f5f9;
        color: #334155;
        border: 1px solid #e2e8f0;
        font-weight: 600;
        font-size: 0.75rem;
        padding: 0.25rem 0.5rem;
        border-radius: 0.35rem;
    }
    .badge-pro-indigo {
        background-color: #eef2ff;
        color: #4338ca;
        border: 1px solid #c7d2fe;
        font-weight: 600;
        font-size: 0.75rem;
        padding: 0.25rem 0.5rem;
        border-radius: 0.35rem;
    }
    .badge-pro-warning {
        background-color: #fffbeb;
        color: #b45309;
        border: 1px solid #fde68a;
        font-weight: 600;
        font-size: 0.75rem;
        padding: 0.25rem 0.5rem;
        border-radius: 0.35rem;
    }
    .badge-pro-info {
        background-color: #eff6ff;
        color: #1d4ed8;
        border: 1px solid #bfdbfe;
        font-weight: 600;
        font-size: 0.75rem;
        padding: 0.25rem 0.5rem;
        border-radius: 0.35rem;
    }
</style>

<div class="teacher-dashboard mb-4 w-100" data-region="teacher-dashboard">

    <!-- Executive Educator Header Banner -->
    <div class="card teacher-header-card mb-3 border-0">
        <div class="card-body pb-0 pt-4 px-3 px-md-4">
            <div class="d-flex flex-wrap align-items-center justify-content-between mb-3 gap-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="p-3 rounded-circle bg-white bg-opacity-10 text-white d-none d-sm-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        {{#pix}}i/course,core{{/pix}}
                    </div>
                    <div>
                        <h3 class="h4 mb-1">
                            Faculty Control Center - Welcome, {{teachername}} 👋
                        </h3>
                        <p class="mb-0">Class management, announcements dispatch, study resource sharing, roster reports, and attendance marking.</p>
                    </div>
                </div>

                <!-- Teacher Quick Actions -->
                <div class="d-flex flex-wrap gap-2">
                    <a href="{{create_course_url}}" class="btn btn-teacher-primary btn-sm px-3 py-2 d-inline-flex align-items-center gap-2">
                        {{#pix}}t/add,core{{/pix}} <span>Create New Course</span>
                    </a>
                    <a href="{{messages_url}}" class="btn btn-banner-outline btn-sm px-3 py-2 d-inline-flex align-items-center gap-1">
                        {{#pix}}t/message,core{{/pix}} Student Messages
                    </a>
                </div>
            </div>

            <!-- Educator Navigation Tabs -->
            <ul class="nav teacher-nav-tabs border-bottom-0 gap-1" id="teacherDashNav" role="tablist">
                <li class="nav-item" role="presentation">
                    <a class="nav-link active d-inline-flex align-items-center gap-2" id="tab-tcourses-link" data-bs-toggle="tab" href="#dash-tcourses" role="tab" aria-controls="dash-tcourses" aria-selected="true">
                        {{#pix}}i/course,core{{/pix}} <span>Taught Classes</span>
                    </a>
                </li>
                <li class="nav-item" role="presentation">
                    <a class="nav-link d-inline-flex align-items-center gap-2" id="tab-treports-link" data-bs-toggle="tab" href="#dash-treports" role="tab" aria-controls="dash-treports" aria-selected="false">
                        {{#pix}}i/report,core{{/pix}} <span>Student Roster & Reports</span>
                    </a>
                </li>
                <li class="nav-item" role="presentation">
                    <a class="nav-link d-inline-flex align-items-center gap-2" id="tab-tnotices-link" data-bs-toggle="tab" href="#dash-tnotices" role="tab" aria-controls="dash-tnotices" aria-selected="false">
                        {{#pix}}i/notifications,core{{/pix}} <span>Announcements & Study Resources</span>
                    </a>
                </li>
                <li class="nav-item" role="presentation">
                    <a class="nav-link d-inline-flex align-items-center gap-2" id="tab-tattendance-link" data-bs-toggle="tab" href="#dash-tattendance" role="tab" aria-controls="dash-tattendance" aria-selected="false">
                        {{#pix}}i/calendar,core{{/pix}} <span>Daily Attendance Manager</span>
                    </a>
                </li>
            </ul>
        </div>
    </div>

    <!-- MAIN 2-COLUMN LAYOUT -->
    <div class="row g-3">

        <!-- LEFT COLUMN: MAIN FACULTY CONTENT (8 Cols) -->
        <div class="col-12 col-xl-9 col-lg-8">

            <!-- Stat Counters -->
            <div class="row g-2 g-md-3 mb-3">
                <div class="col-6 col-md-3">
                    <div class="stat-card-teacher text-center">
                        <div class="stat-value">{{stats.courses_taught}}</div>
                        <div class="stat-label">Courses Taught</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="stat-card-teacher text-center" style="border-top-color: #3b82f6;">
                        <div class="stat-value">{{stats.students_taught}}</div>
                        <div class="stat-label">Total Enrolled Students</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="stat-card-teacher text-center" style="border-top-color: #d97706;">
                        <div class="stat-value">{{stats.pending_grades}}</div>
                        <div class="stat-label">Pending Grades</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="stat-card-teacher text-center" style="border-top-color: #059669;">
                        <div class="stat-value">{{stats.attendance_avg}}</div>
                        <div class="stat-label">Class Attendance Rate</div>
                    </div>
                </div>
            </div>

            <!-- Tab Content -->
            <div class="tab-content" id="teacherDashTabContent">

                <!-- TAB 1: TAUGHT COURSES -->
                <div class="tab-pane fade show active" id="dash-tcourses" role="tabpanel" aria-labelledby="tab-tcourses-link">
                    <div class="card teacher-card">
                        <div class="card-header teacher-card-header py-2 px-3 d-flex align-items-center justify-content-between">
                            <span>{{#pix}}i/course,core{{/pix}} Class & Course Management</span>
                            <a href="{{create_course_url}}" class="btn btn-teacher-primary btn-sm py-1 px-3">+ Add New Course</a>
                        </div>
                        <div class="card-body p-3">
                            <div class="row g-3">
                                {{#taught_courses}}
                                <div class="col-12 col-md-6">
                                    <div class="card h-100 border shadow-sm" style="border-color: #e2e8f0 !important;">
                                        <div class="card-header bg-white fw-bold py-2 d-flex align-items-center justify-content-between border-bottom" style="border-color: #f1f5f9 !important;">
                                            <span class="text-truncate text-dark" style="max-width: 70%;">{{fullname}}</span>
                                            <span class="badge badge-pro-indigo">{{studentcount}} Students</span>
                                        </div>
                                        <div class="card-body py-3 px-3 d-flex flex-column justify-content-between">
                                            <div class="small text-muted mb-3">Category: <strong class="text-secondary">{{categoryname}}</strong></div>
                                            <div class="d-flex flex-wrap gap-2">
                                                <a href="{{courseurl}}" class="btn btn-teacher-primary btn-sm">Enter Class</a>
                                                <a href="{{gradebookurl}}" class="btn btn-pro-outline btn-sm">Gradebook</a>
                                                <a href="{{editurl}}" class="btn btn-pro-outline btn-sm">Settings</a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                {{/taught_courses}}
                                {{^taught_courses}}
                                <div class="col-12 text-center text-muted py-4">
                                    No active courses currently assigned. Click "+ Add New Course" to get started.
                                </div>
                                {{/taught_courses}}
                            </div>
                        </div>
                    </div>
                </div>

                <!-- TAB 2: STUDENT ROSTER & REPORTS -->
                <div class="tab-pane fade" id="dash-treports" role="tabpanel" aria-labelledby="tab-treports-link">
                    <div class="card teacher-card">
                        <div class="card-header teacher-card-header py-2 px-3 d-flex align-items-center justify-content-between">
                            <span>{{#pix}}i/report,core{{/pix}} Enrolled Student Roster & Performance</span>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-hover table-sm align-middle mb-0">
                                <thead style="background-color: #f8fafc; color: #475569; font-size: 0.85rem;">
                                    <tr>
                                        <th class="py-2 px-3">Student Name</th>
                                        <th class="py-2">Email</th>
                                        <th class="py-2">Enrolled Class</th>
                                        <th class="py-2">Attendance</th>
                                        <th class="py-2 text-end px-3">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {{#student_reports}}
                                    <tr>
                                        <td class="fw-semibold text-dark py-2 px-3">{{studentname}}</td>
                                        <td class="text-muted small py-2">{{email}}</td>
                                        <td class="py-2"><span class="badge badge-pro-soft">{{coursename}}</span></td>
                                        <td class="small font-weight-bold text-success py-2">{{attendance}}</td>
                                        <td class="text-end py-2 px-3">
                                            <a href="{{messageurl}}" class="btn btn-pro-outline btn-sm py-1 px-2">Message</a>
                                        </td>
                                    </tr>
                                    {{/student_reports}}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- TAB 3: ANNOUNCEMENTS & STUDY MATERIALS DISPATCHER -->
                <div class="tab-pane fade" id="dash-tnotices" role="tabpanel" aria-labelledby="tab-tnotices-link">
                    <!-- Form 1: Announcement Broadcast -->
                    <div class="card teacher-card mb-3">
                        <div class="card-header teacher-card-header py-2 px-3">
                            <span>{{#pix}}i/notifications,core{{/pix}} Broadcast Class Notice / Announcement</span>
                        </div>
                        <div class="card-body p-3">
                            <form id="noticeDispatchForm">
                                <div class="row g-2 mb-2">
                                    <div class="col-12 col-md-6">
                                        <label class="form-label small font-weight-bold text-secondary mb-1">Target Course</label>
                                        <select class="form-select form-select-sm" style="border-color: #cbd5e1;" required>
                                            <option value="">Select Target Course...</option>
                                            {{#taught_courses}}
                                            <option value="{{id}}">{{fullname}}</option>
                                            {{/taught_courses}}
                                        </select>
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <label class="form-label small font-weight-bold text-secondary mb-1">Priority Level</label>
                                        <select class="form-select form-select-sm" style="border-color: #cbd5e1;">
                                            <option value="normal">Normal Notice</option>
                                            <option value="high">High Priority Notice</option>
                                            <option value="urgent">Urgent Announcement</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="mb-2">
                                    <label class="form-label small font-weight-bold text-secondary mb-1">Notice Heading</label>
                                    <input type="text" class="form-control form-control-sm" style="border-color: #cbd5e1;" placeholder="Enter notice title..." required>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label small font-weight-bold text-secondary mb-1">Notice Content</label>
                                    <textarea class="form-control form-control-sm" style="border-color: #cbd5e1;" rows="2" placeholder="Write message to broadcast to class students..." required></textarea>
                                </div>
                                <button type="submit" class="btn btn-teacher-primary btn-sm px-4 fw-bold">
                                    Broadcast Announcement &rarr;
                                </button>
                            </form>
                        </div>
                    </div>

                    <!-- Form 2: Dispatch Study Files & Links -->
                    <div class="card teacher-card mb-3">
                        <div class="card-header teacher-card-header py-2 px-3">
                            <span>{{#pix}}i/file,core{{/pix}} Share Study Files, Reading Materials & Links</span>
                        </div>
                        <div class="card-body p-3">
                            <form id="studyResourceForm">
                                <div class="row g-2 mb-2">
                                    <div class="col-12 col-md-6">
                                        <label class="form-label small font-weight-bold text-secondary mb-1">Target Class</label>
                                        <select class="form-select form-select-sm" style="border-color: #cbd5e1;" required>
                                            <option value="">Select Target Course...</option>
                                            {{#taught_courses}}
                                            <option value="{{id}}">{{fullname}}</option>
                                            {{/taught_courses}}
                                        </select>
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <label class="form-label small font-weight-bold text-secondary mb-1">Resource Type</label>
                                        <select class="form-select form-select-sm" style="border-color: #cbd5e1;">
                                            <option value="file">File Upload (PDF, DOCX, ZIP)</option>
                                            <option value="link">Web Study Link / URL</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="mb-2">
                                    <label class="form-label small font-weight-bold text-secondary mb-1">Resource Title / Description</label>
                                    <input type="text" class="form-control form-control-sm" style="border-color: #cbd5e1;" placeholder="e.g. Chapter 4 Lecture Slides (PDF)" required>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label small font-weight-bold text-secondary mb-1">File or URL Link</label>
                                    <input type="text" class="form-control form-control-sm" style="border-color: #cbd5e1;" placeholder="Paste website URL or attach file..." required>
                                </div>
                                <button type="submit" class="btn btn-teacher-primary btn-sm px-4 fw-bold">
                                    📤 Share Resource with Class &rarr;
                                </button>
                            </form>
                        </div>
                    </div>
                </div>

                <!-- TAB 4: DAILY ATTENDANCE MANAGER -->
                <div class="tab-pane fade" id="dash-tattendance" role="tabpanel" aria-labelledby="tab-tattendance-link">
                    <div class="card teacher-card">
                        <div class="card-header teacher-card-header py-2 px-3 d-flex align-items-center justify-content-between">
                            <span>{{#pix}}i/calendar,core{{/pix}} Faculty Daily Attendance ("Presenty") Manager</span>
                            <span class="badge badge-pro-indigo">Date: Today</span>
                        </div>
                        <div class="card-body p-3">
                            <p class="small text-muted mb-3">Mark daily attendance for enrolled students in your active classes. Student dashboards update automatically.</p>
                            <div class="table-responsive">
                                <table class="table table-sm align-middle mb-0 border">
                                    <thead style="background-color: #f8fafc;">
                                        <tr>
                                            <th class="py-2 px-3">Student Name</th>
                                            <th class="py-2">Course</th>
                                            <th class="py-2 text-center">Today's Presenty</th>
                                            <th class="py-2 text-end px-3">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {{#student_reports}}
                                        <tr>
                                            <td class="fw-semibold text-dark py-2 px-3">{{studentname}}</td>
                                            <td class="py-2"><span class="badge badge-pro-soft">{{coursename}}</span></td>
                                            <td class="text-center py-2">
                                                <select class="form-select form-select-sm d-inline-block w-auto py-0 px-2 style-select">
                                                    <option value="present" selected>✓ Present</option>
                                                    <option value="absent">❌ Absent</option>
                                                    <option value="late">⏳ Late</option>
                                                </select>
                                            </td>
                                            <td class="text-end py-2 px-3">
                                                <button class="btn btn-pro-outline btn-sm py-0 px-2" onclick="alert('Attendance updated for {{studentname}}!')">Save</button>
                                            </td>
                                        </tr>
                                        {{/student_reports}}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

            </div>

        </div>

        <!-- RIGHT COLUMN: FACULTY SIDEBAR WIDGETS (4 Cols) -->
        <div class="col-12 col-xl-3 col-lg-4">

            <!-- WIDGET 1: Submissions Needing Review -->
            <div class="card teacher-card mb-3">
                <div class="card-header teacher-card-header py-2 px-3 d-flex align-items-center justify-content-between">
                    <span>{{#pix}}i/grades,core{{/pix}} Pending Submissions</span>
                    <span class="badge badge-pro-warning">{{stats.pending_grades}}</span>
                </div>
                <div class="list-group list-group-flush small">
                    {{#pending_grading}}
                    <div class="list-group-item p-3 border-bottom" style="border-color: #f1f5f9 !important;">
                        <div class="fw-bold text-dark mb-1">{{assignmentname}}</div>
                        <div class="text-muted small mb-2">Submitted by: {{studentname}}</div>
                        <a href="{{gradeurl}}" class="btn btn-pro-outline btn-sm py-1 w-100 text-center">Grade Submission &rarr;</a>
                    </div>
                    {{/pending_grading}}
                    {{^pending_grading}}
                    <div class="p-3 text-muted small text-center">
                        All student assignment submissions are fully graded!
                    </div>
                    {{/pending_grading}}
                </div>
            </div>

            <!-- WIDGET 2: Educator Quick Tools -->
            <div class="card teacher-card mb-3">
                <div class="card-header teacher-card-header py-2 px-3">
                    Faculty Action Center
                </div>
                <div class="list-group list-group-flush small">
                    <a href="{{create_course_url}}" class="list-group-item list-group-item-action d-flex align-items-center justify-content-between py-2 px-3">
                        <span>{{#pix}}t/add,core{{/pix}} Create New Course</span>
                        <span class="text-secondary">+</span>
                    </a>
                    <a href="{{question_bank_url}}" class="list-group-item list-group-item-action d-flex align-items-center justify-content-between py-2 px-3">
                        <span>{{#pix}}i/file_plus,core{{/pix}} Question Bank</span>
                        <span class="text-secondary">&rarr;</span>
                    </a>
                    <a href="{{messages_url}}" class="list-group-item list-group-item-action d-flex align-items-center justify-content-between py-2 px-3">
                        <span>{{#pix}}t/message,core{{/pix}} Direct Student Chat</span>
                        <span class="text-secondary">&rarr;</span>
                    </a>
                </div>
            </div>

        </div>

    </div>

</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Nav Tab Switching for Teacher Dashboard
    var navLinks = document.querySelectorAll('#teacherDashNav a[data-bs-toggle="tab"]');
    navLinks.forEach(function(link) {
        link.addEventListener('click', function(e) {
            e.preventDefault();
            navLinks.forEach(function(l) {
                l.classList.remove('active');
                var target = document.querySelector(l.getAttribute('href'));
                if (target) target.classList.remove('show', 'active');
            });
            this.classList.add('active');
            var activeTarget = document.querySelector(this.getAttribute('href'));
            if (activeTarget) activeTarget.classList.add('show', 'active');
        });
    });

    // Handle Announcement Dispatch
    var noticeForm = document.getElementById('noticeDispatchForm');
    if (noticeForm) {
        noticeForm.addEventListener('submit', function(e) {
            e.preventDefault();
            alert('Announcement broadcasted to enrolled students successfully!');
            noticeForm.reset();
        });
    }

    // Handle Study Resource Share
    var studyForm = document.getElementById('studyResourceForm');
    if (studyForm) {
        studyForm.addEventListener('submit', function(e) {
            e.preventDefault();
            alert('Study resource & link shared with class students!');
            studyForm.reset();
        });
    }
});
</script>
