{{!
    Administration dashboard rendered for site admins on the my moodle page.

    @package my
    @copyright 2026
    @license http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
}}
<style>
    /* Blue and Grey Theme Styles for Admin Dashboard & Full Width Layout Override */
    body#page-my-index #page,
    body#page-my-index #page-content,
    body#page-my-index #region-main,
    body#page-my-index .main-inner {
        max-width: 100% !important;
        width: 100% !important;
        padding-left: 0.75rem !important;
        padding-right: 0.75rem !important;
        margin-left: 0 !important;
        margin-right: 0 !important;
    }

    .admin-dashboard {
        font-family: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        color: #1e293b;
    }

    /* Blue & Dark Slate Header Banner */
    .admin-header-card {
        background: linear-gradient(135deg, #0f172a 0%, #1e293b 60%, #1e3a8a 100%);
        color: #ffffff;
        border-radius: 0.75rem;
        box-shadow: 0 4px 15px rgba(15, 23, 42, 0.15);
    }
    .admin-header-card h3 {
        color: #ffffff !important;
        letter-spacing: -0.01em;
    }
    .admin-header-card p {
        color: #cbd5e1 !important;
    }

    /* Tab Styling */
    .admin-nav-tabs .nav-link {
        color: #94a3b8;
        border: none;
        border-bottom: 3px solid transparent;
        font-weight: 600;
        padding: 0.6rem 1rem;
        transition: all 0.2s ease-in-out;
    }
    .admin-nav-tabs .nav-link:hover {
        color: #38bdf8;
        border-bottom-color: rgba(56, 189, 248, 0.4);
    }
    .admin-nav-tabs .nav-link.active {
        color: #ffffff !important;
        background: transparent !important;
        border-bottom-color: #38bdf8 !important;
    }

    /* Metric & Action Cards */
    .admin-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 0.65rem;
        box-shadow: 0 1px 3px rgba(15, 23, 42, 0.05);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .admin-card:hover {
        box-shadow: 0 4px 12px rgba(15, 23, 42, 0.08);
    }
    .admin-card-header {
        background-color: #f8fafc;
        border-bottom: 1px solid #e2e8f0;
        color: #1e293b;
        font-weight: 700;
        font-size: 0.925rem;
    }

    /* Stat Box styling */
    .stat-card-blue {
        border-left: 4px solid #2563eb;
        background: #f8fafc;
    }
    .stat-card-slate {
        border-left: 4px solid #475569;
        background: #f8fafc;
    }
    .stat-card-teal {
        border-left: 4px solid #0d9488;
        background: #f8fafc;
    }
    .stat-card-amber {
        border-left: 4px solid #d97706;
        background: #f8fafc;
    }

    /* Side Feature Widgets */
    .widget-box {
        background: #ffffff;
        border: 1px solid #cbd5e1;
        border-radius: 0.65rem;
        overflow: hidden;
    }
    .widget-box .widget-title {
        background: #f1f5f9;
        border-bottom: 1px solid #e2e8f0;
        color: #0f172a;
        font-size: 0.875rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.03em;
    }

    /* Buttons */
    .btn-blue-primary {
        background-color: #2563eb;
        border-color: #2563eb;
        color: #ffffff !important;
        font-weight: 600;
    }
    .btn-blue-primary:hover {
        background-color: #1d4ed8;
        border-color: #1d4ed8;
    }
    .btn-blue-outline {
        border: 1px solid #3b82f6;
        color: #2563eb !important;
        background-color: #ffffff;
        font-weight: 600;
    }
    .btn-blue-outline:hover {
        background-color: #eff6ff;
        color: #1d4ed8 !important;
    }

    /* Custom Tables */
    .table-blue-grey thead {
        background-color: #f1f5f9;
        color: #334155;
        font-weight: 700;
    }
    .table-blue-grey th {
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        border-bottom: 2px solid #cbd5e1;
    }
</style>

<div class="admin-dashboard mb-4 w-100" data-region="admin-dashboard">

    <!-- Admin Dashboard Main Header & Quick Bar -->
    <div class="card admin-header-card mb-3 border-0">
        <div class="card-body pb-0 pt-4 px-3 px-md-4">
            <div class="d-flex flex-wrap align-items-center justify-content-between mb-3 gap-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="p-3 rounded-circle bg-primary bg-opacity-25 text-white d-none d-sm-flex align-items-center justify-content-center" style="width: 52px; height: 52px;">
                        {{#pix}}i/settings,core{{/pix}}
                    </div>
                    <div>
                        <h3 class="h4 fw-bold mb-1 d-flex align-items-center gap-2">
                            {{paneltitle}}
                        </h3>
                        <p class="small mb-0">System administration overview, site control hub, and analytics reporting center.</p>
                    </div>
                </div>

                <!-- Direct Site Administration & Quick Action Buttons -->
                <div class="d-flex flex-wrap gap-2">
                    <a href="{{siteadmin_url}}" class="btn btn-blue-primary btn-sm px-3 py-2 d-inline-flex align-items-center gap-2 shadow-sm">
                        {{#pix}}i/settings,core{{/pix}}
                        <span class="fw-bold">{{siteadmin_title}}</span>
                    </a>
                    <a href="{{siteadmin_url}}?section=users" class="btn btn-blue-outline btn-sm px-3 py-2 d-inline-flex align-items-center gap-1">
                        {{#pix}}i/users,core{{/pix}} Users
                    </a>
                    <a href="{{siteadmin_url}}?section=courses" class="btn btn-blue-outline btn-sm px-3 py-2 d-inline-flex align-items-center gap-1">
                        {{#pix}}i/course,core{{/pix}} Courses
                    </a>
                </div>
            </div>

            <!-- Dashboard Navigation Tabs -->
            <ul class="nav admin-nav-tabs border-bottom-0 gap-1" id="adminDashNav" role="tablist">
                <li class="nav-item" role="presentation">
                    <a class="nav-link active d-inline-flex align-items-center gap-2" id="tab-overview-link" data-bs-toggle="tab" href="#dash-overview" role="tab" aria-controls="dash-overview" aria-selected="true">
                        {{#pix}}i/dashboard,core{{/pix}} <span>{{tab_overview_title}}</span>
                    </a>
                </li>
                <li class="nav-item" role="presentation">
                    <a class="nav-link d-inline-flex align-items-center gap-2" id="tab-siteadmin-link" data-bs-toggle="tab" href="#dash-siteadmin" role="tab" aria-controls="dash-siteadmin" aria-selected="false">
                        {{#pix}}i/settings,core{{/pix}} <span>Site Administration Hub</span>
                    </a>
                </li>
                <li class="nav-item" role="presentation">
                    <a class="nav-link d-inline-flex align-items-center gap-2" id="tab-reports-link" data-bs-toggle="tab" href="#dash-reports" role="tab" aria-controls="dash-reports" aria-selected="false">
                        {{#pix}}i/report,core{{/pix}} <span>{{tab_reports_title}}</span>
                        <span class="badge bg-info text-dark ms-1" style="font-size: 0.7rem;">Reports</span>
                    </a>
                </li>
            </ul>
        </div>
    </div>

    <!-- MAIN FULL WIDTH 2-COLUMN DASHBOARD GRID (Left Main 8/9 Cols + Right Features 3/4 Cols) -->
    <div class="row g-3">

        <!-- LEFT COLUMN: MAIN CONTENT & TABS (Utilizing main viewport) -->
        <div class="col-12 col-xl-9 col-lg-8">

            <!-- Tab Content -->
            <div class="tab-content" id="adminDashTabContent">

                <!-- TAB 1: OVERVIEW -->
                <div class="tab-pane fade show active" id="dash-overview" role="tabpanel" aria-labelledby="tab-overview-link">

                    <!-- Stats Row -->
                    <div class="row g-2 g-md-3 mb-3">
                        {{#stats}}
                        <div class="col-6 col-md-4 col-xl-2">
                            <div class="card admin-card stat-card-blue h-100">
                                <div class="card-body py-3 px-2 text-center">
                                    <div class="h3 fw-bold mb-0 text-primary">{{value}}</div>
                                    <div class="small text-muted fw-semibold mt-1" style="font-size: 0.75rem;">{{label}}</div>
                                </div>
                            </div>
                        </div>
                        {{/stats}}
                    </div>

                    <!-- Groups Action Grid Row -->
                    <div class="row g-2 g-md-3 mb-3">
                        {{#groups}}
                        <div class="col-12 col-md-6 col-xl-3">
                            <div class="card admin-card h-100">
                                <div class="card-header admin-card-header d-flex align-items-center py-2 px-3">
                                    <span class="me-2 text-primary d-inline-flex">{{#pix}}{{icon}},core{{/pix}}</span>
                                    <span>{{title}}</span>
                                </div>
                                <div class="list-group list-group-flush small">
                                    {{#actions}}
                                    <a href="{{url}}" class="list-group-item list-group-item-action d-flex align-items-center py-2 px-3 text-secondary">
                                        <span class="me-2 d-inline-flex text-muted">{{#pix}}{{icon}},core{{/pix}}</span>
                                        <span>{{label}}</span>
                                    </a>
                                    {{/actions}}
                                </div>
                            </div>
                        </div>
                        {{/groups}}
                    </div>

                    <!-- Overview Data Tables Grid -->
                    <div class="row g-2 g-md-3">
                        <div class="col-12 col-lg-6">
                            {{#tableusers}}
                            <div class="card admin-card h-100">
                                <div class="card-header admin-card-header py-2 px-3 d-flex align-items-center justify-content-between">
                                    <span>{{#pix}}i/users,core{{/pix}} {{title}}</span>
                                    <a href="{{siteadmin_url}}?section=users" class="small text-primary text-decoration-none">Manage &rarr;</a>
                                </div>
                                <div class="table-responsive">
                                    <table class="table table-sm align-middle table-blue-grey mb-0">
                                        <thead>
                                            <tr>
                                                <th>{{colmetric}}</th>
                                                <th class="text-end">{{colcount}}</th>
                                            </tr>
                                        </thead>
                                        <tbody>{{{rowshtml}}}</tbody>
                                    </table>
                                </div>
                            </div>
                            {{/tableusers}}
                        </div>

                        <div class="col-12 col-lg-6">
                            {{#tablecourses}}
                            <div class="card admin-card h-100">
                                <div class="card-header admin-card-header py-2 px-3 d-flex align-items-center justify-content-between">
                                    <span>{{#pix}}i/course,core{{/pix}} {{title}}</span>
                                    <a href="{{siteadmin_url}}?section=courses" class="small text-primary text-decoration-none">Manage &rarr;</a>
                                </div>
                                {{#hasrows}}
                                <div class="table-responsive">
                                    <table class="table table-sm align-middle table-blue-grey mb-0">
                                        <thead>
                                            <tr>
                                                <th>{{colcategory}}</th>
                                                <th class="text-end">{{colvisible}}</th>
                                                <th class="text-end">{{colhidden}}</th>
                                                <th class="text-end">{{coltotal}}</th>
                                            </tr>
                                        </thead>
                                        <tbody>{{{rowshtml}}}</tbody>
                                    </table>
                                </div>
                                {{/hasrows}}
                                {{^hasrows}}
                                <div class="card-body text-muted small py-4 text-center">{{emptymessage}}</div>
                                {{/hasrows}}
                            </div>
                            {{/tablecourses}}
                        </div>

                        <div class="col-12">
                            {{#tablerecent}}
                            <div class="card admin-card">
                                <div class="card-header admin-card-header py-2 px-3 d-flex align-items-center justify-content-between">
                                    <span>{{#pix}}i/log,core{{/pix}} {{title}}</span>
                                    <a href="{{system_status.logsurl}}" class="small text-primary text-decoration-none">Full Logs &rarr;</a>
                                </div>
                                {{#hasrows}}
                                <div class="table-responsive">
                                    <table class="table table-sm align-middle table-blue-grey mb-0">
                                        <thead>
                                            <tr>
                                                <th>{{coluser}}</th>
                                                <th>{{colemail}}</th>
                                                <th class="text-end">{{collastaccess}}</th>
                                            </tr>
                                        </thead>
                                        <tbody>{{{rowshtml}}}</tbody>
                                    </table>
                                </div>
                                {{/hasrows}}
                                {{^hasrows}}
                                <div class="card-body text-muted small py-4 text-center">{{emptymessage}}</div>
                                {{/hasrows}}
                            </div>
                            {{/tablerecent}}
                        </div>
                    </div>

                </div>

                <!-- TAB 2: SITE ADMINISTRATION QUICK HUB -->
                <div class="tab-pane fade" id="dash-siteadmin" role="tabpanel" aria-labelledby="tab-siteadmin-link">
                    <div class="card admin-card p-3 mb-3">
                        <div class="d-flex flex-wrap align-items-center justify-content-between mb-3 gap-2">
                            <div>
                                <h4 class="h5 fw-bold mb-1 text-primary d-flex align-items-center gap-2">
                                    {{#pix}}i/settings,core{{/pix}} Site Administration Directory
                                </h4>
                                <div class="text-muted small">Access all core Moodle administration settings and configuration controls directly.</div>
                            </div>
                            <a href="{{siteadmin_url}}" class="btn btn-blue-primary btn-sm px-3">
                                Open Main Site Admin Page &rarr;
                            </a>
                        </div>

                        <!-- Live Category Filter Bar -->
                        <div class="mb-3">
                            <input type="text" id="adminHubSearch" class="form-control form-control-sm border-primary" placeholder="Search administration modules (e.g. Users, Plugins, Security, Appearance)...">
                        </div>

                        <!-- Categorized Admin Hub Cards -->
                        <div class="row g-3" id="adminHubGrid">
                            <!-- Category 1: Users -->
                            <div class="col-12 col-md-6 col-xl-4 hub-card" data-keywords="users roles cohorts permissions accounts edit upload">
                                <div class="card h-100 border shadow-sm">
                                    <div class="card-header bg-primary text-white fw-bold py-2 d-flex align-items-center gap-2">
                                        {{#pix}}i/users,core{{/pix}} Users & Accounts
                                    </div>
                                    <div class="list-group list-group-flush small">
                                        <a href="{{siteadmin_url}}?section=useraccounts" class="list-group-item list-group-item-action">User Accounts Management</a>
                                        <a href="{{siteadmin_url}}?section=userbulk" class="list-group-item list-group-item-action">Bulk User Actions</a>
                                        <a href="{{siteadmin_url}}?section=roles" class="list-group-item list-group-item-action">Define & Assign Roles</a>
                                        <a href="{{siteadmin_url}}?section=cohorts" class="list-group-item list-group-item-action">System Cohorts</a>
                                    </div>
                                </div>
                            </div>

                            <!-- Category 2: Courses -->
                            <div class="col-12 col-md-6 col-xl-4 hub-card" data-keywords="courses categories enrolments backups request upload">
                                <div class="card h-100 border shadow-sm">
                                    <div class="card-header bg-primary text-white fw-bold py-2 d-flex align-items-center gap-2">
                                        {{#pix}}i/course,core{{/pix}} Courses & Categories
                                    </div>
                                    <div class="list-group list-group-flush small">
                                        <a href="{{siteadmin_url}}?section=coursemgmt" class="list-group-item list-group-item-action">Manage Courses & Categories</a>
                                        <a href="{{siteadmin_url}}?section=addcourse" class="list-group-item list-group-item-action">Add New Course</a>
                                        <a href="{{siteadmin_url}}?section=uploadcourse" class="list-group-item list-group-item-action">Upload Courses</a>
                                        <a href="{{siteadmin_url}}?section=backups" class="list-group-item list-group-item-action">Backups & Restore Defaults</a>
                                    </div>
                                </div>
                            </div>

                            <!-- Category 3: Plugins -->
                            <div class="col-12 col-md-6 col-xl-4 hub-card" data-keywords="plugins modules blocks activity authentication enrol repositories">
                                <div class="card h-100 border shadow-sm">
                                    <div class="card-header bg-primary text-white fw-bold py-2 d-flex align-items-center gap-2">
                                        {{#pix}}i/settings,core{{/pix}} Plugins & Extensions
                                    </div>
                                    <div class="list-group list-group-flush small">
                                        <a href="{{siteadmin_url}}?section=pluginoverview" class="list-group-item list-group-item-action">Plugins Overview</a>
                                        <a href="{{siteadmin_url}}?section=authsettings" class="list-group-item list-group-item-action">Authentication Plugins</a>
                                        <a href="{{siteadmin_url}}?section=manageenrols" class="list-group-item list-group-item-action">Enrolment Plugins</a>
                                        <a href="{{siteadmin_url}}?section=manageblocks" class="list-group-item list-group-item-action">Manage Blocks</a>
                                    </div>
                                </div>
                            </div>

                            <!-- Category 4: Appearance & Themes -->
                            <div class="col-12 col-md-6 col-xl-4 hub-card" data-keywords="appearance theme boost logo navigation dashboard icons">
                                <div class="card h-100 border shadow-sm">
                                    <div class="card-header bg-primary text-white fw-bold py-2 d-flex align-items-center gap-2">
                                        {{#pix}}i/edit,core{{/pix}} Appearance & Theme
                                    </div>
                                    <div class="list-group list-group-flush small">
                                        <a href="{{siteadmin_url}}?section=themesettings" class="list-group-item list-group-item-action">Theme Selector & Settings</a>
                                        <a href="{{siteadmin_url}}?section=logos" class="list-group-item list-group-item-action">Site Logos & Branding</a>
                                        <a href="{{siteadmin_url}}?section=navigation" class="list-group-item list-group-item-action">Navigation Settings</a>
                                        <a href="{{siteadmin_url}}?section=frontpagesettings" class="list-group-item list-group-item-action">Front Page Settings</a>
                                    </div>
                                </div>
                            </div>

                            <!-- Category 5: Server & Performance -->
                            <div class="col-12 col-md-6 col-xl-4 hub-card" data-keywords="server cron purge cache performance memory path php">
                                <div class="card h-100 border shadow-sm">
                                    <div class="card-header bg-primary text-white fw-bold py-2 d-flex align-items-center gap-2">
                                        {{#pix}}i/reload,core{{/pix}} Server & Maintenance
                                    </div>
                                    <div class="list-group list-group-flush small">
                                        <a href="{{system_status.purgeurl}}" class="list-group-item list-group-item-action text-danger fw-semibold">Purging Caches Now</a>
                                        <a href="{{system_status.cronurl}}" class="list-group-item list-group-item-action">Run Cron Task</a>
                                        <a href="{{siteadmin_url}}?section=systempaths" class="list-group-item list-group-item-action">System Paths</a>
                                        <a href="{{siteadmin_url}}?section=performance" class="list-group-item list-group-item-action">Performance Settings</a>
                                    </div>
                                </div>
                            </div>

                            <!-- Category 6: Reports & Security -->
                            <div class="col-12 col-md-6 col-xl-4 hub-card" data-keywords="reports security audit logs permissions ip block checks">
                                <div class="card h-100 border shadow-sm">
                                    <div class="card-header bg-primary text-white fw-bold py-2 d-flex align-items-center gap-2">
                                        {{#pix}}i/report,core{{/pix}} Security & Reports
                                    </div>
                                    <div class="list-group list-group-flush small">
                                        <a href="{{system_status.securityurl}}" class="list-group-item list-group-item-action">Security Overview Report</a>
                                        <a href="{{system_status.logsurl}}" class="list-group-item list-group-item-action">System Logs & Event Audit</a>
                                        <a href="{{siteadmin_url}}?section=ipblocker" class="list-group-item list-group-item-action">IP Blocker Settings</a>
                                        <a href="{{siteadmin_url}}?section=eventlist" class="list-group-item list-group-item-action">Event Trigger List</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- TAB 3: REPORTS GENERATION -->
                <div class="tab-pane fade" id="dash-reports" role="tabpanel" aria-labelledby="tab-reports-link">
                    <div class="card admin-card shadow-sm mb-4">
                        <div class="card-header admin-card-header py-3 px-3">
                            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                                <div>
                                    <h4 class="h5 fw-bold mb-1 d-flex align-items-center gap-2 text-primary">
                                        <span>{{#pix}}i/report,core{{/pix}}</span> {{report_center_title}}
                                    </h4>
                                    <div class="text-muted small">{{report_center_desc}}</div>
                                </div>
                                <div>
                                    <button type="button" class="btn btn-success btn-sm d-flex align-items-center gap-1 shadow-sm" id="btnExportCSV">
                                        {{#pix}}i/export,core{{/pix}} <span>Export CSV</span>
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- Multi-Filter Bar -->
                        <div class="card-body bg-light border-bottom py-3 px-3">
                            <form id="reportFilterForm" class="row g-2 align-items-end">
                                <input type="hidden" id="filterReportType" value="user_activity">

                                <div class="col-12 col-sm-6 col-md-3">
                                    <label for="filterCategory" class="form-label small fw-bold text-secondary mb-1">Report Category</label>
                                    <select id="filterCategory" class="form-select form-select-sm">
                                        <option value="all">All Categories</option>
                                        <option value="users">Users & Accounts</option>
                                        <option value="courses">Courses & Enrolments</option>
                                        <option value="activities">Activities & Grades</option>
                                        <option value="system">System & Audit Logs</option>
                                    </select>
                                </div>

                                <div class="col-12 col-sm-6 col-md-2">
                                    <label for="filterDaterange" class="form-label small fw-bold text-secondary mb-1">Time Period</label>
                                    <select id="filterDaterange" class="form-select form-select-sm">
                                        <option value="0">All Time</option>
                                        <option value="1">Today</option>
                                        <option value="7">Last 7 Days</option>
                                        <option value="30">Last 30 Days</option>
                                        <option value="90">Last 90 Days</option>
                                        <option value="365">Last 365 Days</option>
                                    </select>
                                </div>

                                <div class="col-12 col-sm-6 col-md-2">
                                    <label for="filterRoleId" class="form-label small fw-bold text-secondary mb-1">User Role</label>
                                    <select id="filterRoleId" class="form-select form-select-sm">
                                        <option value="0">All Roles</option>
                                        {{#role_options}}
                                        <option value="{{id}}">{{name}}</option>
                                        {{/role_options}}
                                    </select>
                                </div>

                                <div class="col-12 col-sm-6 col-md-3">
                                    <label for="filterSearch" class="form-label small fw-bold text-secondary mb-1">Search Filter</label>
                                    <input type="text" id="filterSearch" class="form-control form-control-sm" placeholder="Search by keyword...">
                                </div>

                                <div class="col-12 col-md-2 d-flex gap-1">
                                    <button type="submit" class="btn btn-blue-primary btn-sm w-100 fw-bold">
                                        Apply Filter
                                    </button>
                                    <button type="button" id="btnResetFilters" class="btn btn-outline-secondary btn-sm" title="Reset Filters">
                                        Reset
                                    </button>
                                </div>
                            </form>
                        </div>

                        <!-- Report Catalog Grid -->
                        <div class="card-body border-bottom py-3 px-3">
                            <h6 class="fw-bold small text-uppercase text-muted mb-2">Select Special Report Type:</h6>
                            <div class="row g-2" id="reportCatalogGrid">
                                {{#report_catalog}}
                                <div class="col-12 col-sm-6 col-lg-4 report-card-item" data-category="{{category}}">
                                    <div class="card h-100 border report-type-card cursor-pointer" data-report-id="{{id}}" style="cursor: pointer; transition: all 0.2s;">
                                        <div class="card-body p-3 d-flex flex-column justify-content-between">
                                            <div>
                                                <div class="d-flex align-items-center justify-content-between mb-2">
                                                    <span class="badge {{badge_class}}">{{badge}}</span>
                                                    <span class="text-muted small">{{#pix}}{{icon}},core{{/pix}}</span>
                                                </div>
                                                <h6 class="fw-bold card-title mb-1 text-dark">{{title}}</h6>
                                                <p class="card-text text-muted small mb-0">{{desc}}</p>
                                            </div>
                                            <div class="mt-3 pt-2 border-top d-flex align-items-center justify-content-between">
                                                <span class="small text-primary fw-semibold select-report-lbl">Select Report</span>
                                                <span class="badge bg-light text-primary border">Generate &rarr;</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                {{/report_catalog}}
                            </div>
                        </div>

                        <!-- Live Report Table Display -->
                        <div class="card-body p-0">
                            <div class="p-3 bg-white border-bottom d-flex align-items-center justify-content-between flex-wrap gap-2">
                                <div>
                                    <h5 class="h6 fw-bold mb-0 text-dark" id="activeReportTitle">{{default_report.title}}</h5>
                                    <span class="badge bg-light text-dark border mt-1">Total Records: <strong id="activeReportCount">{{default_report.total_count}}</strong></span>
                                </div>
                                <div>
                                    <span class="small text-muted" id="activeReportTimestamp"></span>
                                </div>
                            </div>

                            <div class="table-responsive" style="max-height: 500px; overflow-y: auto;">
                                <table class="table table-hover table-striped align-middle table-blue-grey mb-0" id="reportResultsTable">
                                    <thead class="sticky-top">
                                        <tr id="reportTableHeader">
                                            {{#default_report.headers}}
                                            <th>{{.}}</th>
                                            {{/default_report.headers}}
                                        </tr>
                                    </thead>
                                    <tbody id="reportTableBody">
                                        {{#default_report.rows}}
                                        <tr>
                                            <td>{{col1}}</td>
                                            <td>{{col2}}</td>
                                            <td>{{col3}}</td>
                                            <td>{{{col4}}}</td>
                                            <td>{{col5}}</td>
                                            <td>{{col6}}</td>
                                        </tr>
                                        {{/default_report.rows}}
                                        {{^default_report.rows}}
                                        <tr>
                                            <td colspan="6" class="text-center text-muted py-4">No records found matching the specified filters.</td>
                                        </tr>
                                        {{/default_report.rows}}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>

        <!-- RIGHT COLUMN: SIDE FEATURE WIDGETS (Utilizing full screen right margin space) -->
        <div class="col-12 col-xl-3 col-lg-4">

            <!-- WIDGET 1: Site Administration Quick Search -->
            <div class="widget-box mb-3 shadow-sm">
                <div class="widget-title p-2 px-3 d-flex align-items-center gap-2">
                    {{#pix}}i/search,core{{/pix}} <span>Site Admin Search</span>
                </div>
                <div class="p-3 bg-white">
                    <form action="{{siteadmin_url}}" method="get">
                        <div class="input-group input-group-sm">
                            <input type="text" name="query" class="form-control border-primary" placeholder="Search settings (e.g. cron, security)..." required>
                            <button class="btn btn-blue-primary" type="submit">Go</button>
                        </div>
                    </form>
                    <div class="mt-2 text-muted" style="font-size: 0.75rem;">
                        Directly search any option in Site Administration.
                    </div>
                </div>
            </div>

            <!-- WIDGET 2: System Health & Server Status -->
            <div class="widget-box mb-3 shadow-sm">
                <div class="widget-title p-2 px-3 d-flex align-items-center justify-content-between">
                    <span class="d-flex align-items-center gap-2">{{#pix}}i/settings,core{{/pix}} Server & System Health</span>
                    <span class="badge bg-success text-white" style="font-size: 0.65rem;">Online</span>
                </div>
                <div class="p-3 bg-white">
                    <ul class="list-unstyled mb-3 small">
                        <li class="d-flex justify-content-between py-1 border-bottom">
                            <span class="text-muted">Moodle Version:</span>
                            <span class="fw-bold text-dark">{{system_status.moodleversion}}</span>
                        </li>
                        <li class="d-flex justify-content-between py-1 border-bottom">
                            <span class="text-muted">PHP Engine:</span>
                            <span class="fw-bold text-dark">{{system_status.phpversion}}</span>
                        </li>
                        <li class="d-flex justify-content-between py-1 border-bottom">
                            <span class="text-muted">Database Engine:</span>
                            <span class="fw-bold text-dark">{{system_status.dbtype}}</span>
                        </li>
                        <li class="d-flex justify-content-between py-1 border-bottom">
                            <span class="text-muted">Maintenance Mode:</span>
                            <span class="badge bg-light text-secondary border">{{system_status.maintenancemode}}</span>
                        </li>
                        <li class="d-flex justify-content-between py-1">
                            <span class="text-muted">Last Cron Run:</span>
                            <span class="fw-bold text-primary">{{system_status.cronlastrun}} ago</span>
                        </li>
                    </ul>

                    <!-- Action Buttons -->
                    <div class="d-grid gap-2">
                        <a href="{{system_status.purgeurl}}" class="btn btn-outline-danger btn-sm text-start d-flex align-items-center justify-content-between">
                            <span>{{#pix}}i/trash,core{{/pix}} Purge All Caches</span>
                            <span class="small">&rarr;</span>
                        </a>
                        <a href="{{system_status.cronurl}}" class="btn btn-outline-primary btn-sm text-start d-flex align-items-center justify-content-between">
                            <span>{{#pix}}i/reload,core{{/pix}} Trigger Cron Now</span>
                            <span class="small">&rarr;</span>
                        </a>
                        <a href="{{system_status.securityurl}}" class="btn btn-outline-secondary btn-sm text-start d-flex align-items-center justify-content-between">
                            <span>{{#pix}}i/checkpermissions,core{{/pix}} Run Security Audit</span>
                            <span class="small">&rarr;</span>
                        </a>
                    </div>
                </div>
            </div>

            <!-- WIDGET 3: Quick Administrative Tools Drawer -->
            <div class="widget-box mb-3 shadow-sm">
                <div class="widget-title p-2 px-3 d-flex align-items-center gap-2">
                    {{#pix}}i/navigation,core{{/pix}} <span>Admin Quick Tools</span>
                </div>
                <div class="list-group list-group-flush small">
                    <a href="{{siteadmin_url}}?section=adduser" class="list-group-item list-group-item-action d-flex align-items-center justify-content-between py-2">
                        <span>{{#pix}}t/add,core{{/pix}} Add New User</span>
                        <span class="badge bg-light text-primary border">+</span>
                    </a>
                    <a href="{{siteadmin_url}}?section=addcourse" class="list-group-item list-group-item-action d-flex align-items-center justify-content-between py-2">
                        <span>{{#pix}}i/course,core{{/pix}} Add New Course</span>
                        <span class="badge bg-light text-primary border">+</span>
                    </a>
                    <a href="{{siteadmin_url}}?section=uploaduser" class="list-group-item list-group-item-action d-flex align-items-center justify-content-between py-2">
                        <span>{{#pix}}i/cloudupload,core{{/pix}} Bulk Upload Users</span>
                        <span class="badge bg-light text-secondary border">CSV</span>
                    </a>
                    <a href="{{siteadmin_url}}?section=roles" class="list-group-item list-group-item-action d-flex align-items-center justify-content-between py-2">
                        <span>{{#pix}}t/assignroles,core{{/pix}} Manage User Roles</span>
                        <span class="badge bg-light text-secondary border">Roles</span>
                    </a>
                    <a href="{{siteadmin_url}}?section=plugins" class="list-group-item list-group-item-action d-flex align-items-center justify-content-between py-2">
                        <span>{{#pix}}t/block,core{{/pix}} Manage Plugins</span>
                        <span class="badge bg-light text-secondary border">Plugins</span>
                    </a>
                </div>
            </div>

        </div>

    </div>

</div>

<!-- Interactive Client-side Script -->
<script>
(function() {
    document.addEventListener('DOMContentLoaded', function() {
        var reportsUrl = '{{reports_url}}';

        // 1. Dashboard Nav Tab Switching
        var navLinks = document.querySelectorAll('#adminDashNav a[data-bs-toggle="tab"]');
        navLinks.forEach(function(link) {
            link.addEventListener('click', function(e) {
                e.preventDefault();
                navLinks.forEach(function(l) {
                    l.classList.remove('active');
                    var target = document.querySelector(l.getAttribute('href'));
                    if (target) {
                        target.classList.remove('show', 'active');
                    }
                });
                this.classList.add('active');
                var activeTarget = document.querySelector(this.getAttribute('href'));
                if (activeTarget) {
                    activeTarget.classList.add('show', 'active');
                }
            });
        });

        // Live search filter in Site Admin Directory Tab
        var hubSearch = document.getElementById('adminHubSearch');
        if (hubSearch) {
            hubSearch.addEventListener('input', function() {
                var query = this.value.toLowerCase().trim();
                var cards = document.querySelectorAll('#adminHubGrid .hub-card');
                cards.forEach(function(card) {
                    var keywords = (card.getAttribute('data-keywords') || '').toLowerCase();
                    var text = card.textContent.toLowerCase();
                    if (!query || keywords.indexOf(query) !== -1 || text.indexOf(query) !== -1) {
                        card.style.display = 'block';
                    } else {
                        card.style.display = 'none';
                    }
                });
            });
        }

        // 2. Select Report Type Cards
        var catalogCards = document.querySelectorAll('.report-type-card');
        catalogCards.forEach(function(card) {
            card.addEventListener('click', function() {
                catalogCards.forEach(function(c) {
                    c.classList.remove('border-primary', 'shadow-sm', 'bg-white');
                });
                this.classList.add('border-primary', 'shadow-sm', 'bg-white');
                var reportId = this.getAttribute('data-report-id');
                document.getElementById('filterReportType').value = reportId;
                fetchReportData();
            });
        });

        // Highlight default report card
        var defaultCard = document.querySelector('.report-type-card[data-report-id="user_activity"]');
        if (defaultCard) {
            defaultCard.classList.add('border-primary', 'shadow-sm', 'bg-white');
        }

        // 3. Category Select Dropdown Filter
        var catSelect = document.getElementById('filterCategory');
        if (catSelect) {
            catSelect.addEventListener('change', function() {
                var selectedCat = this.value;
                var items = document.querySelectorAll('.report-card-item');
                items.forEach(function(item) {
                    if (selectedCat === 'all' || item.getAttribute('data-category') === selectedCat) {
                        item.style.display = 'block';
                    } else {
                        item.style.display = 'none';
                    }
                });
                fetchReportData();
            });
        }

        // 4. Filter Form Submit & Reset
        var filterForm = document.getElementById('reportFilterForm');
        if (filterForm) {
            filterForm.addEventListener('submit', function(e) {
                e.preventDefault();
                fetchReportData();
            });
        }

        var btnReset = document.getElementById('btnResetFilters');
        if (btnReset) {
            btnReset.addEventListener('click', function() {
                if (filterForm) filterForm.reset();
                document.getElementById('filterReportType').value = 'user_activity';
                if (catSelect) catSelect.dispatchEvent(new Event('change'));
                fetchReportData();
            });
        }

        // 5. Export CSV Action
        var btnExport = document.getElementById('btnExportCSV');
        if (btnExport) {
            btnExport.addEventListener('click', function() {
                var type = document.getElementById('filterReportType').value;
                var category = document.getElementById('filterCategory').value;
                var daterange = document.getElementById('filterDaterange').value;
                var roleid = document.getElementById('filterRoleId').value;
                var search = encodeURIComponent(document.getElementById('filterSearch').value);

                var exportUrl = reportsUrl + '?action=export&report_type=' + type +
                    '&category=' + category + '&daterange=' + daterange +
                    '&roleid=' + roleid + '&search=' + search;

                window.location.href = exportUrl;
            });
        }

        // 6. Fetch Report Data via AJAX
        function fetchReportData() {
            var type = document.getElementById('filterReportType').value;
            var category = document.getElementById('filterCategory').value;
            var daterange = document.getElementById('filterDaterange').value;
            var roleid = document.getElementById('filterRoleId').value;
            var search = encodeURIComponent(document.getElementById('filterSearch').value);

            var tbody = document.getElementById('reportTableBody');
            if (tbody) {
                tbody.innerHTML = '<tr><td colspan="6" class="text-center py-4 text-muted"><span class="spinner-border spinner-border-sm me-2" role="status"></span> Generating report data...</td></tr>';
            }

            var fetchUrl = reportsUrl + '?action=fetch&report_type=' + type +
                '&category=' + category + '&daterange=' + daterange +
                '&roleid=' + roleid + '&search=' + search;

            fetch(fetchUrl)
                .then(function(res) { return res.json(); })
                .then(function(res) {
                    if (res.status === 'success') {
                        renderReportTable(res.data);
                    } else {
                        if (tbody) tbody.innerHTML = '<tr><td colspan="6" class="text-center py-4 text-danger">Error: ' + res.message + '</td></tr>';
                    }
                })
                .catch(function(err) {
                    if (tbody) tbody.innerHTML = '<tr><td colspan="6" class="text-center py-4 text-danger">Failed to generate report data.</td></tr>';
                });
        }

        function renderReportTable(data) {
            var titleEl = document.getElementById('activeReportTitle');
            var countEl = document.getElementById('activeReportCount');
            var timeEl = document.getElementById('activeReportTimestamp');

            if (titleEl) titleEl.textContent = data.title;
            if (countEl) countEl.textContent = data.total_count;
            if (timeEl) timeEl.textContent = 'Last Updated: ' + new Date().toLocaleTimeString();

            // Headers
            var headerRow = document.getElementById('reportTableHeader');
            if (headerRow) {
                headerRow.innerHTML = '';
                data.headers.forEach(function(h) {
                    var th = document.createElement('th');
                    th.textContent = h;
                    headerRow.appendChild(th);
                });
            }

            // Rows
            var tbody = document.getElementById('reportTableBody');
            if (!tbody) return;
            tbody.innerHTML = '';

            if (!data.rows || data.rows.length === 0) {
                tbody.innerHTML = '<tr><td colspan="' + data.headers.length + '" class="text-center text-muted py-4">No records found matching the specified filters.</td></tr>';
                return;
            }

            data.rows.forEach(function(r) {
                var tr = document.createElement('tr');
                var cols = [r.col1, r.col2, r.col3, r.col4, r.col5, r.col6].slice(0, data.headers.length);
                cols.forEach(function(c) {
                    var td = document.createElement('td');
                    td.innerHTML = c !== undefined ? c : '-';
                    tr.appendChild(td);
                });
                tbody.appendChild(tr);
            });
        }
    });
})();
</script>
